            "post": {
                "tags": [
                    "Chat Rooms"
                ],
                "summary": "Create new chat room",
                "description": "Creates a new group chat room with specified participants",
                "operationId": "createChatRoom",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "participant_ids"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Project Team"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Discussion about project tasks"
                                    },
                                    "participant_ids": {
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        },
                                        "example": "[1,2,3]"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ChatRoomResource"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Forbidden - insufficient permissions"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
