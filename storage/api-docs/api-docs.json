    "components": {
        "schemas": {
            "NotFoundException": {
                "title": "NotFoundException",
                "description": "Not Found Exception data",
                "properties": {
                    "message": {
                        "title": "Message",
                        "description": "Error text",
                        "type": "string",
                        "format": "string",
                        "example": "Record not found."
                    }
                },
                "type": "object",
                "xml": {
                    "name": "NotFoundException"
                }
            },
            "ForbiddenException": {
                "title": "ForbiddenException",
                "description": "Forbidden Exception data",
                "properties": {
                    "message": {
                        "title": "Message",
                        "description": "Error text",
                        "type": "string",
                        "format": "string",
                        "example": "Insufficient permissions"
                    }
                },
                "type": "object",
                "xml": {
                    "name": "ForbiddenException"
                }
            },
            "SuccessResponse": {
                "title": "SuccessResponse",
                "description": "Success",
                "xml": {
                    "name": "SuccessResponse"
                }
            },
            "StoreCommentRequest": {
                "title": "Store Comment request",
                "description": "Store comment request body data",
                "required": [
                    "name"
                ],
                "properties": {
                    "iduser": {
                        "title": "User name",
                        "description": "User name or nickname",
                        "type": "string",
                        "example": "Guest"
                    },
                    "text": {
                        "title": "Comment text",
                        "description": "Comment or message from user",
                        "type": "string",
                        "example": "Some comment text"
                    }
                },
                "type": "object",
                "xml": {
                    "name": "StoreCommentRequest"
                }
            },
            "BlogResource": {
                "title": "BlogResource",
                "description": "Blog resource",
                "properties": {
                    "data": {
                        "title": "Data",
                        "description": "Data wrapper",
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/Blog"
                        }
                    }
                },
                "type": "object",
                "xml": {
                    "name": "BlogResource"
                }
            },
            "ChatMessageResource": {
                "title": "ChatMessageResource",
                "description": "Represents a chat message",
                "properties": {
                    "id": {
                        "description": "The unique identifier of the chat message",
                        "type": "integer"
                    },
                    "chat_room_id": {
                        "description": "The ID of the chat room the message belongs to",
                        "type": "integer"
                    },
                    "user": {
                        "$ref": "#/components/schemas/UserResource"
                    },
                    "user_id": {
                        "description": "The ID of the user who sent the message",
                        "type": "integer"
                    },
                    "message": {
                        "description": "The content of the chat message",
                        "type": "string"
                    },
                    "date": {
                        "description": "The date and time the message was sent",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "The date and time the message was last updated",
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            },
            "ChatRoomCollection": {
                "title": "ChatRoomCollection",
                "description": "Paginated collection of chat rooms",
                "properties": {
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/ChatRoomResource"
                        }
                    },
                    "links": {
                        "description": "Pagination links",
                        "type": "object"
                    },
                    "meta": {
                        "description": "Pagination metadata",
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "ChatRoomResource": {
                "title": "ChatRoomResource",
                "description": "Represents a chat room and its associated data",
                "properties": {
                    "id": {
                        "description": "The unique identifier of the chat room",
                        "type": "integer"
                    },
                    "type": {
                        "description": "The type of the chat room",
                        "type": "string"
                    },
                    "name": {
                        "description": "The name of the chat room",
                        "type": "string"
                    },
                    "description": {
                        "description": "The description of the chat room",
                        "type": "string"
                    },
                    "created_by": {
                        "description": "The ID of the user who created the chat room",
                        "type": "integer"
                    },
                    "date": {
                        "description": "The date and time the chat room was created",
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "description": "The date and time the chat room was last updated",
                        "type": "string",
                        "format": "date-time"
                    },
                    "participants": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/UserResource"
                        }
                    },
                    "latest_message": {
                        "$ref": "#/components/schemas/ChatMessageResource"
                    },
                    "unread_count": {
                        "description": "The number of unread messages for the authenticated user",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "CommentResource": {
                "title": "Blog Comments Resource",
